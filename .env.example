# Agnes API（OpenAI 兼容）。注意用 VERIPAGE_ 前缀，避免与宿主机已有 AGNES_* 环境变量冲突。
VERIPAGE_AGNES_BASE_URL=https://api.agnes-ai.cn/v1
VERIPAGE_AGNES_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型分工（以 docs/model-notes.md 实测结论为准）
VERIPAGE_TEXT_MODEL=agnes-2.5-flash
VERIPAGE_PRO_MODEL=agnes-2.5-pro
VERIPAGE_VISION_MODEL=agnes-2.5-flash
