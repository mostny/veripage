# 模型端点配置（复制为 .env 后填写；.env 已被 .gitignore，真实 Key 只允许出现在那里）
#
# 当前部署（2026-11-15）：DeepSeek，OpenAI 兼容协议，支持文本及 image_url 视觉输入
#   Base URL：https://api.deepseek.com（lib/models.ts 会在其后拼接 /chat/completions）
#   模型：deepseek-flash；历史 StepFun / Agnes 记录见 docs/model-notes.md
#
# 变量名保持历史命名 VERIPAGE_AGNES_*，有两个原因：
#   1) 避免与宿主机已有 AGNES_* 环境变量撞名（Node --env-file 不覆盖已存在变量）；
#   2) 在飞分支仍在用旧名，改名会造成跨分支合并冲突。
# 名字里的 "AGNES" 只是历史命名，不代表实际端点。协议兼容不保证模型能力或计费相同。
VERIPAGE_AGNES_BASE_URL=https://api.deepseek.com
VERIPAGE_AGNES_API_KEY=在此填入你的APIKey
# 模型分工（以 docs/model-notes.md 为准）
VERIPAGE_TEXT_MODEL=deepseek-flash
VERIPAGE_VISION_MODEL=deepseek-flash
# 预留字段，当前主检测链不使用此模型槽位。
VERIPAGE_PRO_MODEL=deepseek-v4-pro
# 显式适配 DeepSeek，避免默认 high 思考消耗当前 120 秒总预算。
# 可设 enabled / disabled；其他端点如不支持此字段应留空，保持服务端原生默认。
VERIPAGE_MODEL_THINKING=disabled
# 主分析器输出预算（max_tokens）。推理模型先产 reasoning 再产 content，
# 预算太小会被 reasoning 吃光导致 JSON 截断；默认 6000，可按端点调整。
# 只接受有限正整数；0.5 / abc 等非法值会回落 6000 并在服务端打警告（审计 F16）。
VERIPAGE_ANALYZER_MAX_TOKENS=6000
VERIPAGE_TEXT_MAX_TOKENS=6000
# 取证浏览器沙箱逃生阀（默认不设＝保留 Chromium OS 级沙箱，审计 F03）。
# 仅个别内核未开 unprivileged user namespace、沙箱确实无法初始化的环境才设 1；
# 开启即放弃 OS 级隔离，必须已有虚拟机/独立容器等更强外层边界兜底。
# Docker 镜像以非 root 用户运行，user namespace 沙箱可用，无需也不应设置。
#VERIPAGE_BROWSER_NO_SANDBOX=1

# 受邀评测登录。先运行 node --experimental-strip-types scripts/create-reviewer.mjs 生成本机配置。
# 密码仅保留 scrypt 哈希；不要在这里填写真实密码或会话密钥。
VERIPAGE_REVIEWER_USERNAME=reviewer
VERIPAGE_REVIEWER_PASSWORD_HASH=
VERIPAGE_SESSION_SECRET=
# 公网使用 HTTPS 完整 origin，支持直接 IP，不带路径或尾斜杠；HTTP 仅允许本机回环测试。
VERIPAGE_PUBLIC_ORIGIN=https://43.136.20.106
